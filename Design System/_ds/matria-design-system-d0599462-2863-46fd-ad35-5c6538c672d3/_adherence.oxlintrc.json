{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/conversacion/**",
              "components/core/**",
              "components/panel/**",
              "ui_kits/**",
              "ui_kits/app_puerpera/**",
              "ui_kits/panel_matrona/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter))/i]",
        "message": "Font not provided by the design system. Available: Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='BarraRiesgo'] > JSXAttribute > JSXIdentifier[name!=/^(?:porNivel|key|ref|className|style|children)$/]",
        "message": "<BarraRiesgo> doesn't accept that prop. Declared props: porNivel."
      },
      {
        "selector": "JSXOpeningElement[name.name='Boton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variante|type|disabled|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Boton> doesn't accept that prop. Declared props: variante, type, disabled, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Boton'] > JSXAttribute[name.name='variante'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Boton> variante must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Boton'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Boton> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Burbuja'] > JSXAttribute > JSXIdentifier[name!=/^(?:de|title|children|key|ref|className|style|children)$/]",
        "message": "<Burbuja> doesn't accept that prop. Declared props: de, title, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Burbuja'] > JSXAttribute[name.name='de'] > Literal[value!=/^(?:puerpera|sistema)$/]",
        "message": "<Burbuja> de must be one of 'puerpera' | 'sistema'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Campo'] > JSXAttribute > JSXIdentifier[name!=/^(?:etiqueta|placeholder|value|onChange|type|ancho|name|key|ref|className|style|children)$/]",
        "message": "<Campo> doesn't accept that prop. Declared props: etiqueta, placeholder, value, onChange, type, ancho, name."
      },
      {
        "selector": "JSXOpeningElement[name.name='Campo'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|search|tel|number)$/]",
        "message": "<Campo> type must be one of 'text' | 'search' | 'tel' | 'number'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:activo|comoPestana|cifra|disabled|onClick|children|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: activo, comoPestana, cifra, disabled, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Cifra'] > JSXAttribute > JSXIdentifier[name!=/^(?:valor|unidad|etiqueta|nota|color|tamano|key|ref|className|style|children)$/]",
        "message": "<Cifra> doesn't accept that prop. Declared props: valor, unidad, etiqueta, nota, color, tamano."
      },
      {
        "selector": "JSXOpeningElement[name.name='Cifra'] > JSXAttribute[name.name='tamano'] > Literal[value!=/^(?:grande|chica)$/]",
        "message": "<Cifra> tamano must be one of 'grande' | 'chica'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Etiqueta'] > JSXAttribute > JSXIdentifier[name!=/^(?:nivel|punto|children|key|ref|className|style|children)$/]",
        "message": "<Etiqueta> doesn't accept that prop. Declared props: nivel, punto, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Etiqueta'] > JSXAttribute[name.name='nivel'] > Literal[value!=/^(?:alto|medio|bajo)$/]",
        "message": "<Etiqueta> nivel must be one of 'alto' | 'medio' | 'bajo'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilaPuerpera'] > JSXAttribute > JSXIdentifier[name!=/^(?:nombre|codigo|edad|tipoParto|dia|nivel|razonamiento|cita|franja|silencio|seleccionada|onSeleccionar|children|key|ref|className|style|children)$/]",
        "message": "<FilaPuerpera> doesn't accept that prop. Declared props: nombre, codigo, edad, tipoParto, dia, nivel, razonamiento, cita, franja, silencio, seleccionada, onSeleccionar, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilaPuerpera'] > JSXAttribute[name.name='tipoParto'] > Literal[value!=/^(?:vaginal|cesárea)$/]",
        "message": "<FilaPuerpera> tipoParto must be one of 'vaginal' | 'cesárea'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilaPuerpera'] > JSXAttribute[name.name='nivel'] > Literal[value!=/^(?:alto|medio|bajo)$/]",
        "message": "<FilaPuerpera> nivel must be one of 'alto' | 'medio' | 'bajo'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Franja42'] > JSXAttribute > JSXIdentifier[name!=/^(?:franja|diaActual|key|ref|className|style|children)$/]",
        "message": "<Franja42> doesn't accept that prop. Declared props: franja, diaActual."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogoMatria'] > JSXAttribute > JSXIdentifier[name!=/^(?:fill|size|punto|key|ref|className|style|children)$/]",
        "message": "<LogoMatria> doesn't accept that prop. Declared props: fill, size, punto."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tarjeta'] > JSXAttribute > JSXIdentifier[name!=/^(?:alta|titulo|ayuda|padding|children|style|key|ref|className|style|children)$/]",
        "message": "<Tarjeta> doesn't accept that prop. Declared props: alta, titulo, ayuda, padding, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TarjetaAlerta'] > JSXAttribute > JSXIdentifier[name!=/^(?:nivel|encabezado|at|children|key|ref|className|style|children)$/]",
        "message": "<TarjetaAlerta> doesn't accept that prop. Declared props: nivel, encabezado, at, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='TarjetaAlerta'] > JSXAttribute[name.name='nivel'] > Literal[value!=/^(?:alto|medio|bajo)$/]",
        "message": "<TarjetaAlerta> nivel must be one of 'alto' | 'medio' | 'bajo'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
